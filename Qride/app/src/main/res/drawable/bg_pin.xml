        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#E0E0E0"/>
        </shape>
    </item>

    <!-- Level pin -->
    <item android:right="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp"/>
            <solid android:color="#00B087"/>
        </shape>
    </item>

</layer-list>