<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow xa -->
    <item android:bottom="4dp">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#22000000" />
        </shape>
    </item>

    <!-- Shadow gần -->
    <item android:bottom="2dp">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#11000000" />
        </shape>
    </item>

    <!-- Nền -->
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/xanhButtonBack" />
        </shape>
    </item>

    <!-- Highlight viền trên (tạo cảm giác nổi) -->
    <item android:top="1dp">
        <shape>
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" /> <!-- trắng mờ -->
        </shape>
    </item>

</layer-list>