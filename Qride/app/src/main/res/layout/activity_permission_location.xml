<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_permission_location.xml
    Màn hình xin quyền vị trí – xác định vị trí người dùng và trạm xe gần nhất
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- Card toàn màn hình (khác 2 màn trước: có bản đồ bên trong) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:layout_centerInParent="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Phần tiêu đề + mô tả -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingBottom="0dp">

                <!-- Tiêu đề -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Cho phép QRIDE sử dụng\nvị trí của bạn"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="8dp" />

                <!-- Mô tả -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="QRIDE cần quyền truy cập vị trí để xác định vị trí của bạn và các trạm xe gần nhất."
                    android:textSize="14sp"
                    android:textColor="@color/text_gray"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- Bản đồ thu nhỏ (MapView hoặc ảnh placeholder) -->
<!--            <com.google.android.gms.maps.MapView-->
<!--                android:id="@+id/mapViewPermission"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="180dp"-->
<!--                android:layout_marginHorizontal="0dp" />-->

            <!--
                Nếu chưa tích hợp Google Maps, thay MapView bằng ImageView:
            -->

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:src="@drawable/img_map_placeholder"
                android:scaleType="centerCrop" />

            <!-- Các nút lựa chọn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="16dp">

                <!-- Cho phép một lần -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLocationOnce"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:text="Cho phép một lần"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/btn_outline_green"
                    android:fontFamily="sans-serif-medium" />

                <!-- Cho phép khi dùng ứng dụng -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLocationAlways"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:text="Cho phép khi dùng ứng dụng"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/btn_outline_green"
                    android:fontFamily="sans-serif-medium" />

                <!-- Từ chối -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDenyLocation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Từ chối"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/btn_outline_green"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>