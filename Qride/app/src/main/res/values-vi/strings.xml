    <!-- Terms & Policies -->
    <string name="dieukhoanvachinhsach">Điều khoản &amp; Chính sách</string>
    <string name="dieukhoansudung">Điều khoản sử dụng</string>
    <string name="terms_welcome">Chào mừng bạn đến với QRIDE. Bằng việc sử dụng dịch vụ, bạn đồng ý tuân thủ các điều khoản dưới đây.</string>
    <string name="terms_acceptance">Sử dụng ứng dụng đồng nghĩa với việc bạn xác nhận đã ĐỌC, HIỂU và đồng ý với các quy định này.</string>
    <string name="terms_modification">QRIDE có thể cập nhật điều khoản và sẽ thông báo đến bạn qua ứng dụng hoặc số điện thoại.</string>
    <string name="terms_service_title">1. Dịch vụ thuê xe tự hành:</string>
    <string name="terms_service_desc">Dịch vụ chia sẻ xe đạp/xe điện, cho phép lấy xe tại trạm bất kỳ và trả xe tại trạm bất kỳ.</string>
    <string name="terms_fee_title">2. Phí dịch vụ</string>
    <string name="terms_fee_desc">Phí được tính như sau:\n• Xe đạp: 5.000đ mở khóa + 1.000đ/3 phút.\n• Xe điện: 7.000đ mở khóa + 2.000đ/3 phút.</string>
    <string name="terms_commitment_title">3. Cam đoan khách hàng</string>
    <string name="terms_commitment_desc">Tuân thủ luật giao thông, không sử dụng xe trái pháp luật và không gây hư hỏng tài sản công ty.</string>
    <string name="terms_liability_title">4. Giới hạn trách nhiệm</string>
    <string name="terms_liability_desc">Bồi thường 100% giá trị nếu gây mất mát tài sản. Công ty không chịu trách nhiệm cho lỗi từ phía khách hàng.</string>
    <string name="privacy_policy_title">Chính sách bảo mật</string>
    <string name="privacy_collect_title">1. Thu thập thông tin</string>
    <string name="privacy_collect_desc">Thu thập họ tên, số điện thoại, CCCD, thông tin thanh toán và vị trí GPS khi dùng dịch vụ.</string>
    <string name="privacy_use_title">2. Sử dụng thông tin</string>
    <string name="privacy_use_desc">Dùng để xác minh danh tính, cung cấp dịch vụ và nâng cao trải nghiệm ứng dụng.</string>
    <string name="privacy_protect_title">3. Bảo vệ thông tin</string>
    <string name="privacy_protect_desc">Áp dụng kỹ thuật bảo mật để ngăn chặn truy cập trái phép hoặc rò rỉ dữ liệu.</string>
    <string name="privacy_rights_title">4. Quyền người dùng</string>
    <string name="privacy_rights_desc">Bạn có quyền truy cập, chỉnh sửa hoặc yêu cầu ngừng sử dụng dữ liệu cá nhân theo quy định.</string>

