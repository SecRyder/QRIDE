    <string name="titTrungTamhotro">Trung tâm hỗ trợ</string>
    <string name="support1">Cần hỗ trợ nhanh vui lòng gọi 1900 123456 (7:00AM - 10:00PM) hoặc chat cùng trung tâm hỗ trợ 24/7 của QRide.</string>
