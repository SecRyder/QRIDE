    <!-- About QRIDE -->
    <string name="aboutQ">Về QRIDE</string>
    <string name="gioithieu">Giới thiệu</string>
    <string name="gioithieu1">Dịch vụ thuê xe tự hành QRIDE là dự án của Công ty TNHH QRIDE, ra đời từ định hướng giao thông xanh theo Chỉ thị 20/CT-TTg. QRIDE hướng tới cung cấp dịch vụ thuê xe thông minh, tiện lợi và an toàn cho thành phố hiện đại.</string>
    <string name="ynghiatenthuonghieu">Ý nghĩa thương hiệu</string>
    <string name="ynghia1">QRIDE kết hợp giữa \"Quick\" và \"Ride\", thể hiện tinh thần di chuyển nhanh chóng, linh hoạt và thân thiện môi trường.</string>
    <string name="sologan">Slogan</string>
    <string name="sologan1">\"MOVE FREELY\" thể hiện triết lý tự do di chuyển, tự do tài chính và tự do lựa chọn lối sống xanh.</string>
    <string name="tamnhinvasumenh">Tầm nhìn &amp; Sứ mệnh</string>
    <string name="tamnhin">Tầm nhìn:</string>
    <string name="tamnhin1">QRIDE hướng tới là thương hiệu dẫn đầu trong lĩnh vực di chuyển xanh tại Việt Nam.</string>
    <string name="sumenh">Sứ mệnh:</string>
    <string name="sumenh1">Mang đến giải pháp di chuyển xanh, tiết kiệm, giúp người dân dễ dàng tiếp cận lối sống bền vững.</string>
    <string name="dinhvithuonghieu">Định vị thương hiệu</string>
    <string name="dinhvi1">QRIDE định vị là dịch vụ di chuyển xanh, an toàn và thông minh, tối ưu hóa trải nghiệm đi lại trong đô thị hiện đại.</string>
    
    <!-- Core Values -->
    <string name="title_core_values">Giá trị cốt lõi</string>
    <string name="label_quality">Chất lượng</string>
    <string name="desc_quality">Cam kết đảm bảo chất lượng vận hành vượt trội trong từng phương tiện và dịch vụ. An toàn là ưu tiên hàng đầu.</string>
    <string name="label_quick">Nhanh chóng</string>
    <string name="desc_quick">Tiết kiệm thời gian cho người dùng: thao tác nhanh, đặt xe dễ dàng và hiệu quả.</string>
    <string name="label_quiet">Yên tĩnh</string>
    <string name="desc_quiet">Xe điện mang lại trải nghiệm di chuyển nhẹ nhàng, không tiếng ồn, giảm ô nhiễm âm thanh đô thị.</string>
    <string name="label_quest">Khám phá</string>
    <string name="desc_quest">Truyền cảm hứng khám phá thành phố theo cách riêng. Tinh thần đổi mới luôn được đề cao.</string>
    <string name="label_sustainability">Bền vững</string>
    <string name="desc_sustainability">Chú trọng phát triển xanh - sạch - bền vững, sử dụng năng lượng điện để giảm phát thải.</string>
    <string name="label_customer_centric">Khách hàng là trọng tâm</string>
    <string name="desc_customer_centric">Mọi cải tiến đều dựa trên nhu cầu và trải nghiệm người dùng. Sự hài lòng của bạn là thước đo của chúng tôi.</string>
    <string name="label_responsibility">Trách nhiệm</string>
    <string name="desc_responsibility">Cung cấp dịch vụ an toàn, đáng tin cậy và đóng góp vào hệ thống giao thông xanh đô thị.</string>
    <string name="label_innovation">Đổi mới</string>
    <string name="desc_innovation">Liên tục áp dụng công nghệ mới để nâng cao chất lượng sản phẩm và tối ưu trải nghiệm.</string>
    <string name="label_freedom">Tự do</string>
    <string name="desc_freedom">Trao quyền tự do di chuyển cho mọi người: tự do lựa chọn và khám phá mọi điểm đến.</string>

